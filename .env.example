# =============================================================================
# Single-Instructor LMS — Root Environment Template
# =============================================================================
# Copy relevant variables to root `.env.local` (Next.js) and `backend/.env` (FastAPI).
# For all backend configuration options, see `backend/.env.example`.
# NEVER commit real secrets, API keys, or credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Next.js 15)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Core Backend (FastAPI + PostgreSQL + Redis)
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Single-Instructor LMS"
API_V1_STR="/api/v1"
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lms_db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-cryptographically-random-32-plus-byte-secret-key
SESSION_COOKIE_NAME=__Host-lms_session
SESSION_COOKIE_SECURE=False
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
