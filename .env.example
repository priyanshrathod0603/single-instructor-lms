# =============================================================================
# Single-Instructor LMS — Root Environment Template
# =============================================================================
# For full backend configuration options, see backend/.env.example.
# =============================================================================

ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Single-Instructor LMS"
API_V1_STR="/api/v1"
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql+psycopg://postgres:1234localhost:5432/lms_db
SECRET_KEY=insecure-dev-secret-key-32-bytes-minimum-length-for-lms-jwt
SESSION_COOKIE_NAME=__Host-lms_session
SESSION_COOKIE_SECURE=True
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
